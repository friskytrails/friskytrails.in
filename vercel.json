{
  "redirects": [
    {
      "source": "/product/:slug",
      "destination": "/tours/:slug",
      "statusCode": 301
    },
    {
      "source": "/product-type/:slug",
      "destination": "/tags/:slug",
      "statusCode": 301
    },
    {
      "source": "/productType/:slug/product",
      "destination": "/tags/:slug",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.friskytrails.in/sitemap.xml"
    },
    {
      "source": "/sitemap-tours-listing.xml",
      "destination": "https://api.friskytrails.in/sitemap-products.xml"
    },
    {
      "source": "/sitemap-tags-listing.xml",
      "destination": "https://api.friskytrails.in/sitemap-productTypes.xml"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "https://api.friskytrails.in/sitemap-static.xml"
    },
    {
      "source": "/sitemap-blogs.xml",
      "destination": "https://api.friskytrails.in/sitemap-blogs.xml"
    },
    {
      "source": "/sitemap-countries.xml",
      "destination": "https://api.friskytrails.in/sitemap-countries.xml"
    },
    {
      "source": "/sitemap-states.xml",
      "destination": "https://api.friskytrails.in/sitemap-states.xml"
    },
    {
      "source": "/sitemap-cities.xml",
      "destination": "https://api.friskytrails.in/sitemap-cities.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
